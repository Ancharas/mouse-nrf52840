#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        scroll_enc: scroll_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <10>;
        };
    };

    macros {
        m_hello: m_hello {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp H &kp E &kp L &kp L &kp O>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK   &mkp RCLK   &mkp MCLK   &mkp MB4
                &mkp MB5    &m_hello    &kp LC(C)   &kp LC(V)
                &kp LC(Z)   &kp LC(LS(ESC)) &none   &none
                &mo 1       &none       &none       &none
            >;
            sensor-bindings = <&scroll_enc>;
        };

        fn_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR
                &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &bootloader
            >;
            sensor-bindings = <&scroll_enc>;
        };
    };
};
